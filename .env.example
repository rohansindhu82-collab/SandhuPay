# Firebase web app config (Firebase Console > Project settings > Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin service account JSON, base64 encoded. Keep Secret in Vercel.
FIREBASE_SERVICE_ACCOUNT_BASE64=

# The exact email of the one merchant account created in Firebase Authentication.
MERCHANT_EMAIL=your-merchant-login@example.com
APP_URL=https://sandhupay.vercel.app

# Select cashfree or razorpay as the default checkout provider.
DEFAULT_PAYMENT_PROVIDER=cashfree

# Cashfree sandbox credentials: https://sandbox.cashfree.com/pg
CASHFREE_ENV=sandbox
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_API_VERSION=2023-08-01

# Razorpay test credentials from Dashboard > Account & Settings > API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
